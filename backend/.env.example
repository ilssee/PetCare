# Copia este archivo como ".env" y completa los valores. El archivo ".env" NO se sube a GitHub.
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=petcare

JWT_SECRET=

# Firebase (notificaciones push). Ruta a la clave de cuenta de servicio, descargada desde la consola de Firebase:
# Configuración del proyecto > Cuentas de servicio > Generar nueva clave privada. Es secreta: no se sube a GitHub.
FIREBASE_CLAVE=./firebase-clave.json

# Pon false para que el servidor no programe los recordatorios de las 8:00 a. m. (por ejemplo, al hacer pruebas)
RECORDATORIOS_ACTIVOS=true
