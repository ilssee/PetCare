    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#4DFFFFFF" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/petcare_border" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
