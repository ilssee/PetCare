<?xml version="1.0" encoding="utf-8"?>
<!-- Opción redonda: se marca con isSelected -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <size android:width="24dp" android:height="24dp" />
                    <solid android:color="@color/petcare_primary" />
                </shape>
            </item>
            <item
                android:bottom="5dp"
                android:drawable="@drawable/ic_check_blanco"
                android:left="5dp"
                android:right="5dp"
                android:top="5dp" />
        </layer-list>
    </item>
    <item>
        <shape android:shape="oval">
            <size android:width="24dp" android:height="24dp" />
            <solid android:color="@color/white" />
            <stroke android:width="1.5dp" android:color="#C5D0D5" />
        </shape>
    </item>
</selector>
