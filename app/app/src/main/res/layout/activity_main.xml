<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/contenedor"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/petcare_border" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/navegacion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:backgroundTint="@color/white"
        app:elevation="0dp"
        app:itemIconTint="@color/color_navegacion"
        app:itemTextAppearanceActive="@style/TextoNavegacionActivo"
        app:itemTextAppearanceInactive="@style/TextoNavegacionInactivo"
        app:itemTextColor="@color/color_navegacion"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_navegacion"
        xmlns:app="http://schemas.android.com/apk/res-auto" />
</LinearLayout>
