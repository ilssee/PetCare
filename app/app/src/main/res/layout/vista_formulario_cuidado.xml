<?xml version="1.0" encoding="utf-8"?>
<!-- Formulario de configuración de un cuidado (modo de término, frecuencia, fechas, aviso y nota).
     Se usa al confirmar la propuesta y se reutilizará al agregar o editar un cuidado. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Cuidado recomendado: nombre y, desplegable, su descripción e importancia -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_tarjeta_suave"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_icono_tarjeta"
                android:importantForAccessibility="no"
                android:padding="11dp"
                android:src="@drawable/ic_escudo"
                android:tint="@color/petcare_primary_dark" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cuidado_recomendado"
                    android:textColor="@color/petcare_text_muted"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/nombreCuidado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:textColor="@color/petcare_text"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/verMasInformacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_info"
                android:tint="@color/petcare_primary_dark" />

            <TextView
                android:id="@+id/textoVerMas"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_semibold"
                android:text="@string/cuidado_ver_mas"
                android:textColor="@color/petcare_primary_dark"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/flechaInformacion"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_desplegar"
                android:tint="@color/petcare_primary_dark" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bloqueInformacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_caja_suave"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="@string/cuidado_descripcion"
                    android:textColor="@color/petcare_primary_dark"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/descripcionCuidado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:layout_marginTop="2dp"
                    android:justificationMode="inter_word"
                    android:textColor="@color/petcare_text"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_caja_suave"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="@string/propuesta_importancia"
                    android:textColor="@color/petcare_primary_dark"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/importanciaCuidado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:layout_marginTop="2dp"
                    android:justificationMode="inter_word"
                    android:textColor="@color/petcare_text"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Aviso veterinario -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_aviso"
        android:orientation="horizontal"
        android:padding="14dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginTop="2dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_info"
            android:tint="@color/petcare_primary_dark" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/cuidado_aviso_veterinario"
            android:textColor="@color/petcare_primary_dark"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Modo de término: cuatro tarjetas con ícono -->
    <TextView
        style="@style/Etiqueta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/cuidado_etiqueta_modo" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/modoUnaVez"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_modo_termino"
            android:orientation="vertical"
            android:padding="12dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_icono_modo"
                android:duplicateParentState="true"
                android:importantForAccessibility="no"
                android:padding="7dp"
                android:src="@drawable/ic_check"
                android:tint="@color/texto_segmento" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="@string/modo_una_vez"
                android:textColor="@color/petcare_text"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/modo_una_vez_detalle"
                android:textColor="@color/petcare_text_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/modoVariasVeces"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_modo_termino"
            android:orientation="vertical"
            android:padding="12dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_icono_modo"
                android:duplicateParentState="true"
                android:importantForAccessibility="no"
                android:padding="7dp"
                android:src="@drawable/ic_lista"
                android:tint="@color/texto_segmento" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="@string/modo_varias_veces"
                android:textColor="@color/petcare_text"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/modo_varias_veces_detalle"
                android:textColor="@color/petcare_text_muted"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/modoHastaFecha"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_modo_termino"
            android:orientation="vertical"
            android:padding="12dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_icono_modo"
                android:duplicateParentState="true"
                android:importantForAccessibility="no"
                android:padding="7dp"
                android:src="@drawable/ic_calendario"
                android:tint="@color/texto_segmento" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="@string/modo_hasta_fecha"
                android:textColor="@color/petcare_text"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/modo_hasta_fecha_detalle"
                android:textColor="@color/petcare_text_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/modoIndefinido"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_modo_termino"
            android:orientation="vertical"
            android:padding="12dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_icono_modo"
                android:duplicateParentState="true"
                android:importantForAccessibility="no"
                android:padding="7dp"
                android:src="@drawable/ic_objetivo"
                android:tint="@color/texto_segmento" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="@string/modo_indefinido"
                android:textColor="@color/petcare_text"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/modo_indefinido_detalle"
                android:textColor="@color/petcare_text_muted"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/errorModo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/petcare_error"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Frecuencia (todos los modos menos "una vez") -->
    <LinearLayout
        android:id="@+id/bloqueFrecuencia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            style="@style/Etiqueta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/cuidado_etiqueta_frecuencia" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="92dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_campo"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <EditText
                    android:id="@+id/campoFrecuencia"
                    style="@style/CampoTexto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:hint="@string/cuidado_hint_frecuencia"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="3" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_campo"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:id="@+id/unidadDias"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_segmento"
                    android:gravity="center"
                    android:text="@string/unidad_dias"
                    android:textColor="@color/texto_segmento"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/unidadSemanas"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.3"
                    android:background="@drawable/bg_segmento"
                    android:gravity="center"
                    android:text="@string/unidad_semanas"
                    android:textColor="@color/texto_segmento"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/unidadMeses"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.1"
                    android:background="@drawable/bg_segmento"
                    android:gravity="center"
                    android:text="@string/unidad_meses"
                    android:textColor="@color/texto_segmento"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/unidadAnios"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_segmento"
                    android:gravity="center"
                    android:text="@string/unidad_anios"
                    android:textColor="@color/texto_segmento"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/errorFrecuencia"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/petcare_error"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Número de veces (solo "varias veces") -->
    <LinearLayout
        android:id="@+id/bloqueVeces"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            style="@style/Etiqueta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/cuidado_etiqueta_veces" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_campo"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <EditText
                android:id="@+id/campoVeces"
                style="@style/CampoTexto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="@string/cuidado_hint_veces"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="3" />
        </LinearLayout>

        <TextView
            android:id="@+id/errorVeces"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/petcare_error"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Fecha límite (solo "hasta una fecha") -->
    <LinearLayout
        android:id="@+id/bloqueLimite"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            style="@style/Etiqueta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/cuidado_etiqueta_limite" />

        <TextView
            android:id="@+id/campoLimite"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_campo"
            android:drawableEnd="@drawable/ic_calendario"
            android:drawableTint="@color/petcare_text_muted"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="14dp"
            android:text="@string/hint_fecha"
            android:textColor="@color/hint_gris"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/errorLimite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/petcare_error"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/textoAproximado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/petcare_texto_suave"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Fecha de inicio -->
    <TextView
        style="@style/Etiqueta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/cuidado_etiqueta_inicio" />

    <TextView
        android:id="@+id/campoInicio"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_campo"
        android:drawableEnd="@drawable/ic_calendario"
        android:drawableTint="@color/petcare_text_muted"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="14dp"
        android:text="@string/hint_fecha"
        android:textColor="@color/hint_gris"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/errorInicio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/petcare_error"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Aviso anticipado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_tarjeta_borde"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:text="@string/cuidado_aviso_titulo"
                android:textColor="@color/petcare_text"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cuidado_aviso_detalle"
                android:textColor="@color/petcare_texto_suave"
                android:textSize="12sp" />
        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/interruptorAviso"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true" />
    </LinearLayout>

    <!-- Nota personal opcional -->
    <TextView
        style="@style/Etiqueta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/cuidado_etiqueta_nota" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_campo"
        android:minHeight="88dp"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <EditText
            android:id="@+id/campoNota"
            style="@style/CampoTexto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:hint="@string/cuidado_hint_nota"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLength="1000"
            android:minLines="3"
            android:singleLine="false" />
    </LinearLayout>
</LinearLayout>
