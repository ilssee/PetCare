<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/botonVolver"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_boton_volver"
            android:contentDescription="@string/descripcion_volver"
            android:padding="10dp"
            android:src="@drawable/ic_volver" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/poppins_semibold"
            android:text="@string/perfil_titulo"
            android:textColor="@color/petcare_text"
            android:textSize="19sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/petcare_border" />

    <ScrollView
        android:id="@+id/desplazamiento"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/contenido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp"
            android:visibility="invisible">

            <!-- Fotos -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:background="@drawable/bg_fotos_perfil"
                android:clipToOutline="true">

                <ImageView
                    android:id="@+id/foto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/ilustracion"
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_circulo_blanco"
                    android:importantForAccessibility="no"
                    android:padding="18dp"
                    android:src="@drawable/ic_mapa_veterinaria" />

                <TextView
                    android:id="@+id/contadorFotos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|top"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_contador_fotos"
                    android:fontFamily="@font/poppins_semibold"
                    android:paddingStart="10dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="3dp"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/fotoAnterior"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_circulo_blanco"
                    android:contentDescription="@null"
                    android:padding="8dp"
                    android:rotation="180"
                    android:src="@drawable/ic_chevron"
                    android:visibility="gone"
                    app:tint="@color/petcare_text" />

                <ImageView
                    android:id="@+id/fotoSiguiente"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_circulo_blanco"
                    android:contentDescription="@null"
                    android:padding="8dp"
                    android:src="@drawable/ic_chevron"
                    android:visibility="gone"
                    app:tint="@color/petcare_text" />

                <LinearLayout
                    android:id="@+id/puntosFotos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal|bottom"
                    android:layout_marginBottom="10dp"
                    android:orientation="horizontal" />
            </FrameLayout>

            <TextView
                android:id="@+id/nombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/poppins_bold"
                android:textColor="@color/petcare_text"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/etiquetaTipo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_etiqueta_pildora"
                android:fontFamily="@font/poppins_semibold"
                android:paddingStart="10dp"
                android:paddingTop="2dp"
                android:paddingEnd="10dp"
                android:paddingBottom="2dp"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_estrella_llena" />

                <TextView
                    android:id="@+id/calificacion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="@color/petcare_text"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/distancia"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textColor="@color/petcare_text_muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_reloj"
                    app:tint="@color/petcare_text" />

                <TextView
                    android:id="@+id/estado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/poppins_bold"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/horarioHoy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textColor="@color/petcare_text"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Dirección escrita (si la tiene) debajo del horario y, a la derecha, la ruta en Google Maps -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="top"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iconoDireccion"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginTop="2dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_ubicacion"
                    android:visibility="gone"
                    app:tint="@color/petcare_text" />

                <TextView
                    android:id="@+id/direccion"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/poppins_regular"
                    android:textColor="@color/petcare_text"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <!-- Sin dirección escrita, "Cómo llegar" queda solo a la derecha -->
                <Space
                    android:id="@+id/espacioDireccion"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/comoLlegar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:background="?attr/selectableItemBackground"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="@string/como_llegar"
                    android:textColor="@color/petcare_primary_dark"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Pestañas -->
            <LinearLayout
                android:id="@+id/pestanas"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_pestanas_perfil"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:id="@+id/pestanaServicios"
                    style="@style/PestanaPerfil"
                    android:text="@string/perfil_pestana_servicios" />

                <TextView
                    android:id="@+id/pestanaContacto"
                    style="@style/PestanaPerfil"
                    android:text="@string/perfil_pestana_contacto" />

                <TextView
                    android:id="@+id/pestanaResenas"
                    style="@style/PestanaPerfil"
                    android:text="@string/perfil_pestana_resenas" />

                <TextView
                    android:id="@+id/pestanaCampanas"
                    style="@style/PestanaPerfil"
                    android:text="@string/perfil_pestana_campanas" />
            </LinearLayout>

            <!-- Contenido de cada pestaña: se llena por código y solo se ve una a la vez -->
            <LinearLayout
                android:id="@+id/contenidoServicios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/contenidoContacto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/contenidoResenas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/contenidoCampanas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/mensajeError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="24dp"
        android:textColor="@color/petcare_error"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
