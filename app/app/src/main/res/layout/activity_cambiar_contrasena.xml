<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/botonVolver"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_boton_volver"
            android:contentDescription="@string/descripcion_volver"
            android:padding="10dp"
            android:src="@drawable/ic_volver" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/poppins_semibold"
            android:text="@string/perfil_cambiar_contrasena"
            android:textColor="@color/petcare_text"
            android:textSize="19sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="4dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

        <TextView
            style="@style/Etiqueta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/etiqueta_contrasena_actual" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_campo"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="4dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_candado" />

            <EditText
                android:id="@+id/campoActual"
                style="@style/CampoTexto"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:hint="@string/hint_contrasena"
                android:importantForAutofill="no"
                android:inputType="textPassword" />
            <ImageView
                android:id="@+id/ojoActual"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/descripcion_ver_contrasena"
                android:padding="10dp"
                android:src="@drawable/ic_ojo" />
        </LinearLayout>

        <TextView
            android:id="@+id/errorActual"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/error_campo_obligatorio"
            android:textColor="@color/petcare_error"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            style="@style/Etiqueta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/etiqueta_contrasena_nueva" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_campo"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="4dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_candado" />

            <EditText
                android:id="@+id/campoNueva"
                style="@style/CampoTexto"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:hint="@string/hint_contrasena"
                android:importantForAutofill="no"
                android:inputType="textPassword" />
            <ImageView
                android:id="@+id/ojoNueva"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/descripcion_ver_contrasena"
                android:padding="10dp"
                android:src="@drawable/ic_ojo" />
        </LinearLayout>

        <TextView
            android:id="@+id/errorNueva"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/error_campo_obligatorio"
            android:textColor="@color/petcare_error"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            style="@style/Etiqueta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/etiqueta_contrasena_repetir" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_campo"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="4dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_candado" />

            <EditText
                android:id="@+id/campoRepetir"
                style="@style/CampoTexto"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:hint="@string/hint_contrasena"
                android:importantForAutofill="no"
                android:inputType="textPassword" />
            <ImageView
                android:id="@+id/ojoRepetir"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/descripcion_ver_contrasena"
                android:padding="10dp"
                android:src="@drawable/ic_ojo" />
        </LinearLayout>

        <TextView
            android:id="@+id/errorRepetir"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/error_campo_obligatorio"
            android:textColor="@color/petcare_error"
            android:textSize="13sp"
            android:visibility="gone" />

            <TextView
                android:id="@+id/textoError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/petcare_error"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="vertical"
        android:padding="16dp">

        <Button
            android:id="@+id/botonGuardarContrasena"
            style="@style/BotonPrincipal"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/boton_guardar_contrasena" />
    </LinearLayout>
</LinearLayout>
