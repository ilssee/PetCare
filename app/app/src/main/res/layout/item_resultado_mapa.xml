<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginTop="5dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="5dp"
    android:background="@drawable/bg_tarjeta_resultado"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/icono"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:background="@drawable/bg_icono_resultado"
        android:importantForAccessibility="no"
        android:padding="11dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/nombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/poppins_semibold"
            android:maxLines="2"
            android:textColor="@color/petcare_text"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/etiquetaClase"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_etiqueta_pildora"
                android:backgroundTint="@color/etiqueta_clase_fondo"
                android:fontFamily="@font/poppins_semibold"
                android:paddingStart="9dp"
                android:paddingTop="1dp"
                android:paddingEnd="9dp"
                android:paddingBottom="1dp"
                android:textColor="@color/white"
                android:textSize="11.5sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_etiqueta_pildora"
                android:fontFamily="@font/poppins_semibold"
                android:paddingStart="9dp"
                android:paddingTop="1dp"
                android:paddingEnd="9dp"
                android:paddingBottom="1dp"
                android:textSize="11.5sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/detalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/petcare_text_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/detalle2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/petcare_text_muted"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/filaEstrellas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/estrellas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/textoCalificacion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="@color/petcare_text_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/filaCampanas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_mapa_campana"
                app:tint="@color/mapa_activa" />

            <TextView
                android:id="@+id/textoCampanas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="@color/mapa_activa"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron"
        app:tint="@color/petcare_text" />
</LinearLayout>
