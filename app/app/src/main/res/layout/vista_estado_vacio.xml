<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="28dp">

    <ImageView
        android:id="@+id/icono"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/bg_circulo_suave"
        android:importantForAccessibility="no"
        android:padding="20dp"
        android:tint="@color/petcare_primary" />

    <TextView
        android:id="@+id/titulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/poppins_semibold"
        android:gravity="center"
        android:textColor="@color/petcare_text"
        android:textSize="17sp" />

    <TextView
        android:id="@+id/mensaje"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:textColor="@color/petcare_texto_suave"
        android:textSize="13sp" />

    <Button
        android:id="@+id/boton"
        style="@style/BotonPrincipal"
        android:layout_width="wrap_content"
        android:layout_height="46dp"
        android:layout_marginTop="16dp"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:text="@string/boton_agregar_mascota"
        android:textSize="15sp" />
</LinearLayout>
