<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tarjeta"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:background="@drawable/bg_tarjeta_borde"
    android:orientation="vertical">

    <!-- Resumen: tocar la cabecera abre o cierra el cuidado -->
    <LinearLayout
        android:id="@+id/cabecera"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <ImageView
            android:id="@+id/fotoMascota"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_circulo_blanco"
            android:importantForAccessibility="no"
            android:padding="4dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/nombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="@color/petcare_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/realizado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/petcare_text_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/proxima"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/petcare_text_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/estado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_pastilla"
            android:fontFamily="@font/poppins_semibold"
            android:paddingStart="10dp"
            android:paddingTop="3dp"
            android:paddingEnd="10dp"
            android:paddingBottom="3dp"
            android:textSize="11sp" />

        <!-- Opciones del cuidado (editar y eliminar): a la izquierda de la flecha, solo con el cuidado abierto -->
        <ImageView
            android:id="@+id/botonOpciones"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="-4dp"
            android:contentDescription="@string/cuidado_mas_opciones"
            android:padding="10dp"
            android:src="@drawable/ic_mas_opciones"
            android:tint="@color/petcare_text"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/flecha"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="6dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_desplegar"
            android:tint="@color/petcare_text" />
    </LinearLayout>

    <!-- Contenido abierto -->
    <LinearLayout
        android:id="@+id/detalle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="14dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tarjeta_suave"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cuidado_proxima_fecha"
                    android:textColor="@color/petcare_text_muted"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/valorProximaFecha"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/poppins_semibold"
                    android:textColor="@color/petcare_text"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tarjeta_suave"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cuidado_etiqueta_frecuencia"
                    android:textColor="@color/petcare_text_muted"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/valorFrecuencia"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/poppins_semibold"
                    android:textColor="@color/petcare_text"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/verDetalles"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/textoVerDetalles"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:text="@string/cuidado_ver_detalles"
                android:textColor="@color/petcare_primary_dark"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/flechaDetalles"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="4dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_desplegar"
                android:tint="@color/petcare_primary_dark" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bloqueDetalles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/cajaDescripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_tarjeta_suave"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="@string/cuidado_descripcion"
                    android:textColor="@color/petcare_text_muted"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/valorDescripcion"
                    android:layout_marginTop="2dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:justificationMode="inter_word"
                    android:textColor="@color/petcare_text"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cajaImportancia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_tarjeta_suave"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="@string/propuesta_importancia"
                    android:textColor="@color/petcare_text_muted"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/valorImportancia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/poppins_regular"
                    android:justificationMode="inter_word"
                    android:textColor="@color/petcare_text"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cajaNota"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_tarjeta_suave"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="@string/cuidado_nota_titulo"
                    android:textColor="@color/petcare_text_muted"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/valorNota"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/poppins_regular"
                    android:textColor="@color/petcare_text"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Duración y aviso anticipado: datos secundarios, juntos en una caja al final de los detalles -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_tarjeta_suave"
                android:orientation="vertical"
                android:padding="10dp">

                <!-- Cada dato en una línea: el subtítulo en negrita lo agrega el código al inicio del texto -->
                <TextView
                    android:id="@+id/valorDuracion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:textColor="@color/petcare_text"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/valorAviso"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/poppins_regular"
                    android:textColor="@color/petcare_text"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Marcar como completado: después de los detalles y antes del historial -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/botonCompletar"
                style="@style/BotonPrincipal"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="@string/cuidado_completar"
                android:textSize="14sp"
                app:icon="@drawable/ic_check_blanco"
                app:iconGravity="textStart"
                app:iconTint="@color/white" />

            <TextView
                android:id="@+id/avisoFinalizado"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/cuidado_finalizo"
                android:textColor="@color/petcare_text_muted"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Historial de actividades -->
        <TextView
            android:id="@+id/tituloHistorial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/poppins_semibold"
            android:letterSpacing="0.05"
            android:text="@string/cuidado_historial"
            android:textColor="@color/petcare_text_muted"
            android:textSize="11sp" />

        <LinearLayout
            android:id="@+id/historial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/sinHistorial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/cuidado_sin_historial"
            android:textColor="@color/petcare_texto_suave"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/verTodasActividades"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/poppins_semibold"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textColor="@color/petcare_primary_dark"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
