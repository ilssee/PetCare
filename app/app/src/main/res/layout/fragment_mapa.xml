<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.osmdroid.views.MapView
        android:id="@+id/mapa"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Buscador y categorías, sobre el mapa -->
    <LinearLayout
        android:id="@+id/encabezado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_busqueda_mapa"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="10dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_buscar" />

            <EditText
                android:id="@+id/campoBusqueda"
                style="@style/CampoTexto"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_regular"
                android:hint="@string/mapa_buscar_hint"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLength="100"
                android:textSize="15sp" />

            <ImageButton
                android:id="@+id/limpiarBusqueda"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/mapa_descripcion_limpiar"
                android:src="@drawable/ic_cerrar"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/chipVeterinarias"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/bg_chip_mapa"
                android:clickable="true"
                android:elevation="4dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:id="@+id/iconoChipVeterinarias"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_mapa_veterinaria"
                    app:tint="@color/petcare_primary" />

                <TextView
                    android:id="@+id/textoChipVeterinarias"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="@string/mapa_categoria_veterinarias"
                    android:textColor="@color/petcare_text"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/chipCampanas"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_chip_mapa"
                android:clickable="true"
                android:elevation="4dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:id="@+id/iconoChipCampanas"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_mapa_campana"
                    app:tint="@color/petcare_primary" />

                <TextView
                    android:id="@+id/textoChipCampanas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="@string/mapa_categoria_campanas"
                    android:textColor="@color/petcare_text"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Parte de abajo: leyenda y botón de información, datos del elemento tocado y listado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:id="@+id/leyenda"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|bottom"
                android:background="@drawable/bg_busqueda_mapa"
                android:elevation="6dp"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="20dp"
                android:paddingBottom="12dp"
                android:visibility="gone">

                <LinearLayout style="@style/FilaLeyenda">

                    <FrameLayout
                        android:layout_width="18dp"
                        android:layout_height="18dp">

                        <View
                            style="@style/PuntoLeyenda"
                            android:layout_gravity="center"
                            android:backgroundTint="@color/mapa_privada" />
                    </FrameLayout>

                    <TextView
                        style="@style/TextoLeyenda"
                        android:text="@string/mapa_leyenda_privada" />
                </LinearLayout>

                <LinearLayout style="@style/FilaLeyenda">

                    <FrameLayout
                        android:layout_width="18dp"
                        android:layout_height="18dp">

                        <View
                            style="@style/PuntoLeyenda"
                            android:layout_gravity="center"
                            android:backgroundTint="@color/mapa_municipal" />
                    </FrameLayout>

                    <TextView
                        style="@style/TextoLeyenda"
                        android:text="@string/mapa_leyenda_municipal" />
                </LinearLayout>

                <LinearLayout style="@style/FilaLeyenda">

                    <FrameLayout
                        android:layout_width="18dp"
                        android:layout_height="18dp">

                        <View
                            style="@style/PuntoLeyenda"
                            android:layout_gravity="center"
                            android:backgroundTint="@color/mapa_activa" />
                    </FrameLayout>

                    <TextView
                        style="@style/TextoLeyenda"
                        android:text="@string/mapa_leyenda_activa" />
                </LinearLayout>

                <LinearLayout style="@style/FilaLeyenda">

                    <FrameLayout
                        android:layout_width="18dp"
                        android:layout_height="18dp">

                        <View
                            style="@style/PuntoLeyenda"
                            android:layout_gravity="center"
                            android:backgroundTint="@color/mapa_proxima" />
                    </FrameLayout>

                    <TextView
                        style="@style/TextoLeyenda"
                        android:text="@string/mapa_leyenda_proxima" />
                </LinearLayout>

                <LinearLayout style="@style/FilaLeyenda">

                    <FrameLayout
                        android:layout_width="18dp"
                        android:layout_height="18dp">

                        <View
                            style="@style/PuntoLeyenda"
                            android:layout_width="9dp"
                            android:layout_height="9dp"
                            android:layout_gravity="center"
                            android:backgroundTint="@color/mapa_ubicacion" />
                    </FrameLayout>

                    <TextView
                        style="@style/TextoLeyenda"
                        android:text="@string/mapa_leyenda_ubicacion" />
                </LinearLayout>
            </LinearLayout>

            <!-- Centra el mapa en la ubicación del usuario; va encima del botón de información -->
            <ImageButton
                android:id="@+id/botonUbicacion"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end|bottom"
                android:layout_marginBottom="60dp"
                android:background="@drawable/bg_circulo_blanco"
                android:contentDescription="@string/mapa_descripcion_ubicacion"
                android:elevation="6dp"
                android:padding="12dp"
                android:src="@drawable/ic_objetivo"
                app:tint="@color/petcare_primary_dark" />

            <ImageButton
                android:id="@+id/botonLeyenda"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end|bottom"
                android:background="@drawable/bg_circulo_blanco"
                android:contentDescription="@string/mapa_descripcion_leyenda"
                android:elevation="6dp"
                android:padding="12dp"
                android:src="@drawable/ic_info"
                app:tint="@color/petcare_text" />
        </FrameLayout>

        <!-- Listado deslizable -->
        <LinearLayout
            android:id="@+id/panelLista"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hoja_mapa"
            android:elevation="10dp"
            android:orientation="vertical"
            android:visibility="gone">

            <View
                android:id="@+id/asa"
                android:layout_width="44dp"
                android:layout_height="5dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_asa_mapa" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/tituloLista"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="@color/petcare_text"
                    android:textSize="17sp" />

                <LinearLayout
                    android:id="@+id/botonOrdenar"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_pildora_ordenar"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_ordenar" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="@string/mapa_ordenar"
                        android:textColor="@color/petcare_primary_dark"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/botonFiltros"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_pildora_filtros"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_filtros" />

                    <TextView
                        android:id="@+id/textoFiltros"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="@string/mapa_filtros"
                        android:textColor="@color/petcare_primary_dark"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/mensajeVacio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="28dp"
                android:textColor="@color/petcare_text_muted"
                android:textSize="14sp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/lista"
                android:layout_width="match_parent"
                android:layout_height="270dp"
                android:clipToPadding="false"
                android:paddingBottom="10dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
