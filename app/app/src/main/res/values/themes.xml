<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.PetCare" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/petcare_primary</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.PetCare" parent="Base.Theme.PetCare" />

    <!-- Textos reutilizables -->
    <style name="Etiqueta">
        <item name="android:textColor">@color/petcare_text_muted</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
    </style>

    <style name="CampoTexto">
        <item name="android:background">@null</item>
        <item name="android:textColor">@color/petcare_text</item>
        <item name="android:textColorHint">#757575</item>
        <item name="android:textSize">14sp</item>
        <item name="android:singleLine">true</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
    </style>

    <style name="BotonPrincipal">
        <item name="android:background">@drawable/bg_boton_principal</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
