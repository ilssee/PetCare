<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".PetCareApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PetCare">

        <!-- Avisos con la app abierta y renovación del token del celular (Firebase). -->
        <service
            android:name=".notificacion.PetCareMensajes"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Canal y color de los avisos que Android muestra con la app cerrada. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="recordatorios" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_huella" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/petcare_primary" />

        <activity
            android:name=".usuario.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".usuario.RegistroActivity"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <activity
            android:name=".mascota.MascotaFormActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".mascota.MascotaPerfilActivity"
            android:exported="false" />

        <activity
            android:name=".mascota.MascotaRegistradaActivity"
            android:exported="false" />

        <activity
            android:name=".cuidado.PropuestaActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".recordatorio.RecordatoriosActivity"
            android:exported="false" />

        <activity
            android:name=".cuidado.InfoPreventivaActivity"
            android:exported="false" />

        <activity
            android:name=".cuidado.CuidadoFormActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".usuario.EditarPerfilActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".usuario.CambiarContrasenaActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>
